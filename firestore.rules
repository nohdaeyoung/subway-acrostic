rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /acrostics/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "dynoworld@gmail.com";
    }
    match /curvePoints/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "dynoworld@gmail.com";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
